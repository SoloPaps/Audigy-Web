{
  "name": "audigy",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22 <25"
  },
  "scripts": {
    "guard": "node scripts/guard-no-deploy.ts",
    "lint": "biome check .",
    "copy-lint": "node scripts/copy-lint.ts",
    "format": "biome check --write .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm --filter @audigy/web run check:types",
    "test": "vitest run",
    "test:ui": "pnpm --filter @audigy/web run test:ui && pnpm --filter @audigy/browser-runner run test:ui",
    "test:a11y": "node scripts/lighthouse-a11y.mjs",
    "fixtures": "node fixtures/server.ts",
    "lab": "tsx fixtures/lab.ts",
    "lab:audit": "tsx scripts/lab-audit.ts",
    "audigy": "tsx packages/cli/src/bin.ts",
    "build": "node scripts/build.mjs",
    "build:functions": "node scripts/build-functions.ts",
    "self-audit": "tsx scripts/self-audit.ts",
    "check": "pnpm guard && pnpm lint && pnpm copy-lint && pnpm typecheck && pnpm test && pnpm build && pnpm self-audit && pnpm test:ui && pnpm test:a11y"
  },
  "dependencies": {
    "@audigy/orchestrator": "workspace:*"
  },
  "devDependencies": {
    "@audigy/browser-runner": "workspace:*",
    "@audigy/net": "workspace:*",
    "@biomejs/biome": "^2.6.3",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^22.20.5",
    "esbuild": "^0.28.2",
    "lighthouse": "^13.6.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
