# Noms seulement. Aucune valeur réelle dans le dépôt. Voir docs/PLAN.md §9.
# Les secrets restent sur la machine. `.env` n'est jamais commité (ignoré par Git).
# `pnpm lab` crée `.env` avec le Supabase local, et `apps/web/.env` avec seulement
# SUPABASE_URL et SUPABASE_ANON_KEY. `pnpm build` charge le `.env` racine pour
# les figer dans le site. Ne commitez ni `.env` ni `apps/web/.env`.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
GOOGLE_API_KEY=
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
TOKEN_ENC_KEY=
SIGNING_PRIVATE_KEY=
BREVO_API_KEY=
GH_DISPATCH_TOKEN=
NVD_API_KEY=
PLACES_API_KEY=
# Repli public (prod : https://…). En http local, OAuth suit l'hôte du navigateur
# (localhost ou 127.0.0.1, même port). Le client Google doit autoriser les deux
# URI http://localhost:8888/api/oauth/google/callback et
# http://127.0.0.1:8888/api/oauth/google/callback, et les origines JS
# http://localhost:8888 et http://127.0.0.1:8888.
APP_BASE_URL=
