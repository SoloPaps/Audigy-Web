---
import LaunchAudit from '../components/LaunchAudit.svelte';
import { t } from '../i18n/index.js';
import Base from '../layouts/Base.astro';
---

<Base title={t('meta.launch.title')} description={t('meta.launch.description')}>
  <div class="reading">
    <section class="glass glass-module">
      <div class="glass-plate">
        <h1>{t('launch.title')}</h1>
        <LaunchAudit client:load />
      </div>
    </section>
  </div>
</Base>
