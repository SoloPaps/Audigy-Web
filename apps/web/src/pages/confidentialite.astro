---
import PageToc from '../components/PageToc.astro';
import { t } from '../i18n/index.js';
import Base from '../layouts/Base.astro';

const email = t('legal.email');
---

<Base still title={t('meta.privacy.title')} description={t('meta.privacy.description')}>
  <h1>{t('privacy.title')}</h1>
  <p class="prose">{t('terms.date')}</p>
  <p class="prose">{t('legal.review')}</p>
  <PageToc
    items={[
      { id: 'privacy-who', label: t('privacy.who.title') },
      { id: 'privacy-what', label: t('privacy.what.title') },
      { id: 'privacy-why', label: t('privacy.why.title') },
      { id: 'privacy-how', label: t('privacy.how.title') },
      { id: 'privacy-keep', label: t('privacy.keep.title') },
      { id: 'privacy-rights', label: t('privacy.rights.title') },
    ]}
  />

  <h2 id="privacy-who">{t('privacy.who.title')}</h2>
  <p class="prose">{t('privacy.who.body')}</p>
  <p class="prose">
    {t('privacy.who.contact')}{' '}
    <a class="link-inline" href={`mailto:${email}`}>{email}</a>
  </p>

  <h2 id="privacy-what">{t('privacy.what.title')}</h2>
  <p class="prose">{t('privacy.what.account')}</p>
  <p class="prose">{t('privacy.what.sites')}</p>
  <p class="prose">{t('privacy.what.google')}</p>
  <p class="prose">{t('privacy.what.logs')}</p>

  <h2 id="privacy-why">{t('privacy.why.title')}</h2>
  <p class="prose">{t('privacy.why.body')}</p>
  <p class="prose">{t('privacy.why.basis')}</p>

  <h2 id="privacy-how">{t('privacy.how.title')}</h2>
  <p class="prose">{t('privacy.how.eu')}</p>
  <p class="prose">{t('privacy.how.us')}</p>
  <p class="prose">{t('privacy.how.mail')}</p>
  <p class="prose">{t('privacy.how.google')}</p>
  <p class="prose">{t('privacy.how.github')}</p>
  <p class="prose">{t('privacy.how.none')}</p>
  <p class="prose">{t('privacy.cookies')}</p>

  <h2 id="privacy-keep">{t('privacy.keep.title')}</h2>
  <p class="prose">{t('privacy.keep.results')}</p>
  <p class="prose">{t('privacy.keep.files')}</p>
  <p class="prose">{t('privacy.keep.warc')}</p>
  <p class="prose">{t('privacy.keep.account')}</p>

  <h2 id="privacy-rights">{t('privacy.rights.title')}</h2>
  <p class="prose">{t('privacy.rights.export')}</p>
  <p class="prose">{t('privacy.rights.delete')}</p>
  <p class="prose">
    {t('privacy.rights.mail')}{' '}
    <a class="link-inline" href={`mailto:${email}`}>{email}</a>
  </p>
  <p class="prose">{t('privacy.rights.cnil')}</p>
  <p class="prose">{t('privacy.share')}</p>
  <p class="prose"><a class="link-inline" href="/compte">{t('account.title')}</a></p>
</Base>
