---
import { t } from '../i18n/index.js';
import Base from '../layouts/Base.astro';

const email = t('legal.email');
const site = t('legal.site');
---

<Base still title={t('meta.mentions.title')} description={t('meta.mentions.description')}>
  <h1>{t('mentions.title')}</h1>
  <p class="prose">{t('terms.date')}</p>
  <p class="prose">{t('legal.review')}</p>

  <h2>{t('mentions.editor.title')}</h2>
  <p class="prose">{t('mentions.editor.body')}</p>
  <p class="prose">{t('mentions.editor.anon')}</p>
  <p class="prose">{t('mentions.editor.law')}</p>
  <p class="prose">{t('mentions.director')}</p>

  <h2>{t('mentions.contact.title')}</h2>
  <p class="prose">
    {t('mentions.contact.body')}
    <a class="link-inline" href={`mailto:${email}`}>{email}</a>
  </p>
  <p class="prose">{t('mentions.site', { site })}</p>

  <h2>{t('mentions.host.title')}</h2>
  <p class="prose">{t('mentions.host.body')}</p>
  <p class="prose">{t('mentions.host.address')}</p>
  <p class="prose">{t('mentions.host.mail')}</p>
  <p class="prose">{t('mentions.host.phone')}</p>
  <p class="prose">{t('mentions.data')}</p>
</Base>
