---
import { ClientRouter, fade } from 'astro:transitions';
import SiteBar from '../components/SiteBar.svelte';
import ThemeToggle from '../components/ThemeToggle.svelte';
import { t } from '../i18n/index.js';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import '../styles/arc.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
  print?: boolean;
  jsonLd?: string;
  still?: boolean;
}

const {
  title,
  description,
  robots,
  print = false,
  jsonLd,
  still = false,
} = Astro.props;
const canonical = Astro.url.pathname || '/';
const here = canonical.length > 1 ? canonical.replace(/\/$/u, '') : canonical;
const themeParam = Astro.url.searchParams.get('theme');
const initialTheme =
  themeParam === 'light' || themeParam === 'dark' ? themeParam : 'system';
---

<!doctype html>
<html lang="fr" transition:animate={fade({ duration: '280ms' })}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {jsonLd ? <script type="application/ld+json" set:html={jsonLd} /> : null}
    {robots ? <meta name="robots" content={robots} /> : null}
    <ClientRouter fallback="swap" />
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body class:list={{ 'blobs-still': still }}>
    <a class="skip" href="#contenu">{t('skip.content')}</a>
    <div class="blobs" aria-hidden="true">
      <div class="blob blob-petrol"></div>
      <div class="blob blob-peach"></div>
      <div class="blob blob-lilac"></div>
    </div>
    <header class:list={['site-bar', { 'print-hide': print }]}>
      <div class="glass bar-glass">
        <div class="glass-plate bar-plate">
          <a
            class="brand link-nav"
            href="/"
            aria-current={here === '/' ? 'page' : undefined}
          >{t('brand.name')}</a>
          <SiteBar pathname={Astro.url.pathname} client:load />
          <ThemeToggle initial={initialTheme} client:load />
        </div>
      </div>
    </header>
    <main id="contenu" class:list={['wrap', { legal: still }]} tabindex="-1">
      <noscript><p>{t('noscript')}</p></noscript>
      <slot />
    </main>
    <footer class:list={['site-footer', { 'print-hide': print }]}>
      <nav class="footer-nav" aria-label={t('footer.legal')}>
        <a class="link-footer" href="/methode">{t('footer.method.nav')}</a>
        <a class="link-footer" href="/cgu">{t('footer.terms')}</a>
        <a class="link-footer" href="/confidentialite">{t('footer.privacy')}</a>
        <a class="link-footer" href="/mentions-legales">{t('footer.mentions')}</a>
        <a class="link-footer" href="/accessibilite">{t('footer.a11y')}</a>
      </nav>
    </footer>
  </body>
</html>
