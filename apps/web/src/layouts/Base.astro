---
import ThemeToggle from '../components/ThemeToggle.svelte';
import { t } from '../i18n/index.js';
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';

interface Props {
  title: string;
  description: string;
  robots?: string;
  print?: boolean;
  jsonLd?: string;
}

const { title, description, robots, print = false, jsonLd } = Astro.props;
const canonical = Astro.url.pathname || '/';
const themeParam = Astro.url.searchParams.get('theme');
const initialTheme =
  themeParam === 'light' || themeParam === 'dark' ? themeParam : 'system';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {jsonLd ? <script type="application/ld+json" set:html={jsonLd} /> : null}
    {robots ? <meta name="robots" content={robots} /> : null}
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <header class:list={['site-header', { 'print-hide': print }]}>
      <a class="skip" href="#contenu">{t('skip.content')}</a>
      <a class="brand" href="/">{t('brand.name')}</a>
      <nav class="site-nav" aria-label={t('nav.main')}>
        <a href="/sites">{t('nav.sites')}</a>
        <a href="/compte">{t('nav.account')}</a>
        <a href="/connexion">{t('nav.login')}</a>
      </nav>
      <ThemeToggle initial={initialTheme} client:load />
    </header>
    <main id="contenu" class="wrap" tabindex="-1">
      <noscript><p>{t('noscript')}</p></noscript>
      <slot />
    </main>
    <footer class:list={['site-footer', { 'print-hide': print }]}>
      <p>{t('footer.note')}</p>
      <nav class="footer-nav" aria-label={t('footer.legal')}>
        <a href="/mentions-legales">{t('footer.mentions')}</a>
        <a href="/confidentialite">{t('footer.privacy')}</a>
        <a href="/cgu">{t('footer.terms')}</a>
        <a href="/accessibilite">{t('footer.a11y')}</a>
        <a href="/methode">{t('footer.method.nav')}</a>
      </nav>
    </footer>
  </body>
</html>
