---
import { t } from '../i18n/index.js';

interface Item {
  id: string;
  label: string;
}

interface Props {
  items: Item[];
}

const { items } = Astro.props;
---

<nav class="page-toc" aria-label={t('toc.label')}>
  <ol>
    {
      items.map((item) => (
        <li>
          <a class="link-inline" href={`#${item.id}`}>
            {item.label}
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .page-toc {
    margin: var(--space-4) 0 var(--space-6);
  }

  ol {
    margin: 0;
    padding-inline-start: var(--space-5);
  }

  li + li {
    margin-top: var(--space-2);
  }
</style>
